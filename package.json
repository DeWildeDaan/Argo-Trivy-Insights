{
  "name": "argo-trivy-insights",
  "version": "0.1.0",
  "private": true,
  "description": "Argo CD UI extension showing Trivy insights",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "package": "npm run build && tar -C dist -czf dist/extension-trivy-insights.tar.gz resources",
    "install:dev": "npm run build && ./scripts/dev-install.sh",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "css-loader": "^7.1.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.91.0",
    "webpack-cli": "^7.2.2"
  }
}
